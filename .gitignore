# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/.next-test/
/.test-data/
/.next-cli-build/
/out/
cli/.build-home/
product
# production
/build
result
.idea/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Generated from custom-server.ts by apps/web/scripts/copy-standalone-assets.mjs on every build.
# The pattern is listed per directory because the file moved into apps/web/ during the monorepo
# split; the bare `/custom-server.js` stopped matching then, which is how a build artefact came to
# be committed and drift from the source it is generated from.
/custom-server.js
apps/web/custom-server.js

# CLI ESM runtime/build output generated from TypeScript sources
/cli/cli.js
/cli/hooks/*.js
/cli/scripts/*.js
/cli/src/cli/**/*.js

.bin/*
data/
logs/*
source/*
.cursor/*
docs/*
!docs/ARCHITECTURE.md
test/*
open-sse/test/*
RM.vn.md
RM.md
cursor/*
PUBLIC.md
Thanks.md
PUBLIC.en.md
PR/*
package-lock.json
pnpm-lock.yaml
# bun.lock is the committed lockfile; it must never be ignored.


#Ignore vscode AI rules
.github/instructions/codacy.instructions.md
README1.md
deploy*.sh
# `deploy*.sh` is unanchored, so it matches deploy/<host>/*.sh too and silently
# drops the deploy scripts CI ships to the VPS. Keep the root-level Coolify
# deploy.sh ignored, but never let it eat a per-host script.
!deploy/**/*.sh
ecosystem.config.*

scripts/agSniffer/*
gitbooks/*
gitbook/README.md

# Refactor backup reference (do not bundle/lint)
open-sse.old/
.graphifyignore
graphify-out/*

# Local-only working dirs (notes, vendored repos, scripts, skills)
.claude/
.docs/
.repo/
.script/
.codegraph/
.PR/
.next-analyze/*

# Kiro local workspace state
.kiro/
9router-*

# Local sensitive / temp files
.engine-token.txt
.tmp-prov.json
.tmp-providers.json
.oauth-session.json
.dev-server.log
.dev-server-err.log
.start-dev.ps1
start-dev-silent.cjs
debug.log
.scratch/

# Build artifacts / lint scratch
tsc_out.txt
tsconfig.tsbuildinfo
eslint.tmp.mjs
.codebuddy-tools/
# Kana stack migration helper scripts (one-shot codemods, not shipped)
.codebuddy-tools/

# moon + planning state (local)
/.moon/cache/
.planning/

# Build output of workspace members (root-anchored patterns above do not follow
# the apps/* move, so re-anchor them here).
apps/*/.next/
apps/*/.next-dev/
apps/*/.next-cli-build/
apps/*/out/
apps/*/dist/
apps/web/next-env.d.ts
apps/web/.next/standalone/

# Workspace-member dependencies (bun links per-package node_modules)
apps/*/node_modules/
cli/node_modules/
packages/*/node_modules/
