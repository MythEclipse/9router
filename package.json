{
  "name": "9router",
  "version": "7.0.0",
  "description": "9Router — local AI routing gateway + dashboard (Kana stack)",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli"
  ],
  "scripts": {
    "dev": "bun --filter 9router-web dev",
    "build": "bun --filter 9router-web build",
    "start": "bun --filter 9router-web start",
    "typecheck": "bun run typecheck:web && bun run typecheck:api",
    "lint": "node scripts/biome-baseline.mjs",
    "lint:fix": "biome check --write",
    "lint:baseline": "node scripts/biome-baseline.mjs --update",
    "format": "biome format --write",
    "check": "bun run lint && bun run typecheck",
    "test": "vitest run --root tests",
    "cli:pack": "bun --filter 9router pack:cli",
    "cli:publish": "bun --filter 9router publish:cli",
    "bump": "node scripts/bump-version.mjs",
    "sync:opencode-harness": "node scripts/sync-opencode-harness.mjs",
    "prepare": "if command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "typecheck:web": "cd apps/web && node ../../node_modules/typescript/bin/tsc --noEmit",
    "typecheck:api": "cd apps/api && node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@moonrepo/cli": "^2.6.4",
    "@types/node": "^22.9.0",
    "lefthook": "^2.2.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
