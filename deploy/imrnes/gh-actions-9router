#!/bin/bash
# The only thing the 9router deploy key can run on imrnes.
#
# Installed at /usr/local/bin/gh-actions-9router and referenced from
# authorized_keys as a forced command, so a leaked key cannot open a shell: ssh
# runs this script with the requested command in SSH_ORIGINAL_COMMAND, and
# anything outside the allowlist is refused.
#
# `scp` is a special case. It runs over ssh, so the forced command receives an
# `scp -t <dir>` invocation instead of a name from the allowlist. It is accepted
# only when the destination is the upload directory, because that is the one
# place CI is allowed to write.

set -euo pipefail

UPLOAD_DIR=/opt/9router/upload
DEPLOY_SCRIPT=/opt/9router/deploy.sh

log() { logger -t gh-actions-9router -- "$*" 2>/dev/null || true; }

# SFTP is refused explicitly. A modern `scp` negotiates SFTP by default, and
# without this branch the refusal reaches the caller as a bare "Connection
# closed" with no hint that `-O` (original scp protocol) is what is wanted.
if [[ "${SSH_ORIGINAL_COMMAND:-}" == "sftp"* ]]; then
  log "refused sftp"
  echo "refused: sftp is not available on this key; use scp -O (original protocol)" >&2
  exit 1
fi

# The destination arrives as whatever the client typed, which for
# `scp file host:upload` is the *relative* string `upload` — the remote shell
# resolves it against the login home, not against the upload directory. So a
# relative name that lands in the upload dir is accepted by resolving it the same
# way ssh does, rather than requiring an absolute path the workflow would have to
# remember to send.
if [[ "${SSH_ORIGINAL_COMMAND:-}" == "scp -t "* ]]; then
  dest=${SSH_ORIGINAL_COMMAND#scp -t }
  # Trim trailing slashes so `upload` and `upload/` compare equal.
  dest=${dest%/}
  case "$dest" in
    "$UPLOAD_DIR"|upload|./upload) dest=$UPLOAD_DIR ;;
    *) dest=$(readlink -m "$dest") ;;
  esac
  if [ "$dest" != "$UPLOAD_DIR" ]; then
    log "refused scp to $dest"
    echo "refused: uploads are only accepted into $UPLOAD_DIR" >&2
    exit 1
  fi
  log "scp accepted into $dest"
  exec scp -t "$dest"
fi

case "${SSH_ORIGINAL_COMMAND:-}" in
  status)
    # A cheap, meaningful probe the workflow uses to prove the key works before
    # it tries to deploy. It must not be `true`: that is not in the allowlist and
    # a refusal reads as a broken key.
    if [ -f "$DEPLOY_SCRIPT" ]; then
      echo "ready: deploy script present"
    else
      echo "not ready: $DEPLOY_SCRIPT is missing" >&2
      exit 1
    fi
    ;;
  deploy)
    log "deploy requested"
    exec bash "$DEPLOY_SCRIPT"
    ;;
  "")
    echo "this key is restricted to the deploy allowlist" >&2
    exit 1
    ;;
  *)
    log "refused command: $SSH_ORIGINAL_COMMAND"
    echo "refused: only 'status', 'deploy' and scp into $UPLOAD_DIR are allowed" >&2
    exit 1
    ;;
esac
