{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@9router/pricing": ["../pricing/src/index.ts"],
      "@9router/db": ["../db/src/index.ts"],
      "@9router/db/*": ["../db/src/*"],
      "@9router/auth": ["./src/index.ts"],
      "@9router/auth/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "../db/src/bun-sqlite.d.ts"],
  "exclude": ["node_modules"]
}
