{
  "name": "9router-api",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./application/use-cases": "./src/application/use-cases.ts",
    "./application/dependencies": "./src/application/dependencies.ts",
    "./infrastructure/use-cases-factory": "./src/infrastructure/use-cases-factory.ts",
    "./infrastructure/session-from-cookie": "./src/infrastructure/session-from-cookie.ts",
    "./domain/*": "./src/domain/*.ts",
    "./infrastructure/db/repositories/*": "./src/infrastructure/db/repositories/*.ts",
    "./application/usage/*": "./src/application/usage/*.ts",
    "./infrastructure/runtime-ports": "./src/infrastructure/runtime-ports.ts",
    "./application/models/*": "./src/application/models/*.ts",
    "./application/providers/*": "./src/application/providers/*.ts",
    "./application/settings/*": "./src/application/settings/*.ts",
    "./application/proxy-pools/*": "./src/application/proxy-pools/*.ts",
    "./application/tunnel/*": "./src/application/tunnel/*.ts",
    "./application/oauth/*": "./src/application/oauth/*.ts",
    "./application/cli-tools/*": "./src/application/cli-tools/*.ts",
    "./application/claude-tools/*": "./src/application/claude-tools/*.ts",
    "./application/codex-profiles/*": "./src/application/codex-profiles/*.ts",
    "./presentation/orpc/router": "./src/presentation/orpc/router.ts",
    "./presentation/orpc/base": "./src/presentation/orpc/base.ts",
    "./presentation/caller-from-session": "./src/presentation/caller-from-session.ts"
  },
  "scripts": {
    "dev": "bun --conditions=react-server --watch src/main.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun --conditions=react-server dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@9router/auth": "workspace:*",
    "@9router/db": "workspace:*",
    "@9router/pricing": "workspace:*",
    "@orpc/client": "^1.16.1",
    "@orpc/openapi": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@orpc/zod": "^1.16.1",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "jose": "^5.10.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11"
  }
}
