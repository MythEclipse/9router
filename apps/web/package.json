{
  "name": "9router-web",
  "version": "5.1.6",
  "description": "9Router web dashboard + gateway host",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NEXT_DIST_DIR=.next-dev bun --bun next dev --port 20128 --hostname 127.0.0.1",
    "dev:webpack": "cross-env NEXT_DIST_DIR=.next-dev bun --bun next dev --port 20128 --hostname 127.0.0.1",
    "dev:node": "cross-env NEXT_DIST_DIR=.next-dev next dev --port 20128 --hostname 127.0.0.1",
    "build": "bun --bun next build",
    "build:node": "next build",
    "postbuild": "node scripts/ensure-sharp-runtime-alias.mjs && node scripts/copy-standalone-assets.mjs",
    "start": "bun custom-server.js --port 20127",
    "start:node": "node custom-server.js --port 20127"
  },
  "dependencies": {
    "9router-api": "workspace:*",
    "@9router/auth": "workspace:*",
    "@9router/db": "workspace:*",
    "@9router/pricing": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "16.4.3",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "^5.22.0",
    "@xyflow/react": "^12.10.1",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.5.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.0.0",
    "confbox": "^0.2.4",
    "diff": "^7.0.0",
    "enquirer": "^2.4.1",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.7",
    "material-symbols": "^0.44.6",
    "next": "16.4.3",
    "next-themes": "^0.4.4",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.53.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.3.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^3.7.0",
    "sharp": "^0.33.5",
    "socks-proxy-agent": "^8.0.5",
    "sql.js": "^1.14.1",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "@aws-sdk/credential-providers": "^3.1135.0",
    "wreq-js": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.11",
    "@types/diff": "^7.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.2.3",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4"
  }
}
