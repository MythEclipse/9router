{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "open-sse": ["./open-sse"],
      "open-sse/*": ["./open-sse/*"],
      "@9router/db": ["../../packages/db/src/index.ts"],
      "@9router/db/*": ["../../packages/db/src/*"],
      "@9router/pricing": ["../../packages/pricing/src/index.ts"],
      "@9router/auth": ["../../packages/auth/src/index.ts"],
      "@9router/auth/*": ["../../packages/auth/src/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "open-sse/**/*",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-cli-build/types/**/*.ts",
    ".next-cli-build/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".next-cli-build"]
}
